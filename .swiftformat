# SwiftFormat configuration for LifeView.

--swiftversion 6.0
--indent 4
--tabwidth 4
--maxwidth 140
--linebreaks lf
--semicolons never
--commas inline
--trimwhitespace always
--ifdef no-indent
--wraparguments before-first
--wrapparameters before-first
--wrapcollections before-first
--closingparen balanced
--funcattributes prev-line
--typeattributes prev-line
--varattributes same-line
--stripunusedargs closure-only
--self remove
--patternlet hoist
--ranges spaced
--operatorfunc spaced
--elseposition same-line
--guardelse same-line
--header ignore

# Excludes
--exclude .build
--exclude DerivedData
--exclude **/.build
--exclude **/.swiftpm
--exclude LifeView.xcodeproj

# Enabled rules (defaults plus a few opt-ins).
--enable isEmpty
--enable redundantSelf
--enable trailingClosures
--enable wrapMultilineStatementBraces
