// Shared build settings for all configurations.

// Deployment target
MACOSX_DEPLOYMENT_TARGET = 14.0

// Architectures: universal (Apple Silicon + Intel)
ARCHS = arm64 x86_64
VALID_ARCHS = arm64 x86_64

// Swift
SWIFT_VERSION = 6.0
SWIFT_STRICT_CONCURRENCY = complete

// Bundle
PRODUCT_BUNDLE_IDENTIFIER = fr.andreadelre.LifeView
PRODUCT_NAME = LifeView

// Signing — Automatic by default. A free personal Apple ID is
// enough to get OS-level grants working locally (notifications,
// sandbox, etc.). CI passes CODE_SIGN_IDENTITY="" /
// CODE_SIGNING_ALLOWED=NO on the xcodebuild command line so the
// headless runner doesn't need a developer identity.
//
// Local team id: copy `Config/Local.xcconfig.example` to
// `Config/Local.xcconfig` and fill in your 10-char personal team
// (Xcode → Settings → Accounts → "Manage Certificates…" shows it).
// `Local.xcconfig` is git-ignored.
CODE_SIGN_STYLE = Automatic

// Optional per-machine override. The `?` makes the include silent
// when the file is absent — CI / first-time clones build fine.
#include? "Local.xcconfig"

// Misc
ENABLE_HARDENED_RUNTIME = YES
CLANG_ENABLE_MODULES = YES
SWIFT_INSTALL_OBJC_HEADER = NO
ALWAYS_SEARCH_USER_PATHS = NO
COMBINE_HIDPI_IMAGES = YES
